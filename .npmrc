# Supply-chain wait: npm will not install a version published less than 7 days
# ago (most malicious releases are caught and pulled within days). Needs npm 11.10+.
# Matches the 7-day cooldown in .github/dependabot.yml; `npm ci` and the
# lockfile are unaffected.
min-release-age=7
# npm older than 11.10 silently ignores min-release-age, so package.json
# "engines" requires 11.10+ and this makes an older npm fail loudly instead.
engine-strict=true
