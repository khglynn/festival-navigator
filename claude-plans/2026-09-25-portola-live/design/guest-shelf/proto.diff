--- a/js/v3/join-shelf.js
+++ b/js/v3/join-shelf.js
@@ -0,0 +1,159 @@
+// The join shelf (design round "guest-shelf", 2026-09-25 — PROTOTYPE).
+//
+// A guest who wants to pick is asked who they are on a shelf that rises over
+// the wall, never a screen that replaces it: the wall stays where it was
+// (dimmed, behind), so "Look around" is just the shelf going back down, and a
+// join lands the pick on a card you can still see. The production sheet's
+// anatomy (grabber, 20px top corners, dock ground, .45 backdrop) — the same
+// family as every footer shelf in the app.
+//
+// Prototype scope: the rendering and every state the frames show (names,
+// a name tapped, a name typed, a new name, offline, the keyboard). The
+// answers themselves (claim / join / offline join / the waiting pick) are
+// renderJoin's code in app.js, to be moved here unchanged — not rewritten.
+import { GROW_MS, OUT_MS, CASCADE_MS, STAGGER_MS, EASE_ARRIVE, EASE_LEAVE, canAnimate } from './motion.js';
+
+export const SHELF_WORDS = {
+  line: (artist) => (artist ? ['Pick ', artist, ' as…'] : ['Pick shows as…']),
+  sub: 'Tap your name, or add yourself.',
+  subOffline: 'You’re offline — join anyway, it sends when you’re back.',
+  field: 'Add your name',
+  look: 'Look around',
+  join: 'Join',
+  joinAs: (name) => `Join as ${name}`,
+  claim: (name) => `I’m ${name}`,
+};
+
+const ID = 'join-shelf';
+function node(tag, cls, text) {
+  const n = document.createElement(tag);
+  if (cls) n.className = cls;
+  if (text != null) n.textContent = text;
+  return n;
+}
+
+export function joinShelf() { return document.getElementById(ID); }
+
+// people: [{ name, bg, stroke }] in the crew's order.
+export function showJoinShelf({ artist = null, people = [], offline = false, ctx = null, onLook, onClaim, onJoin } = {}) {
+  closeJoinShelf({ instant: true });
+  const back = node('div', 'sheet-backdrop join-backdrop');
+  const sheet = node('div', 'sheet join-shelf');
+  sheet.id = ID;
+  sheet.setAttribute('role', 'dialog');
+  sheet.setAttribute('aria-label', artist ? `Pick ${artist} as` : 'Pick shows as');
+  const grab = node('div', 'grabber');
+
+  const head = node('div', 'js-head');
+  const line = node('div', 'js-line');
+  const parts = SHELF_WORDS.line(artist);
+  if (artist) line.append(parts[0], node('b', null, parts[1]), parts[2]);
+  else line.textContent = parts[0];
+  const sub = node('div', 'js-sub' + (offline ? ' offline' : ''), offline ? SHELF_WORDS.subOffline : SHELF_WORDS.sub);
+  head.append(line, sub);
+
+  const names = node('div', 'js-names');
+  names.setAttribute('role', 'group');
+  names.setAttribute('aria-label', 'The crew');
+  const chips = people.map((p) => {
+    const b = node('button', 'person-chip js-name');
+    b.style.background = p.bg;
+    b.style.border = `1px solid ${p.stroke}`;
+    b.dataset.name = p.name;
+    b.append(node('span', 'js-initial', p.name.charAt(0).toUpperCase()), node('span', 'js-nm', p.name));
+    names.appendChild(b);
+    return b;
+  });
+  const namesWrap = node('div', 'js-names-wrap');
+  namesWrap.appendChild(names);
+
+  const field = node('input', 'js-field');
+  field.maxLength = 24;
+  field.placeholder = SHELF_WORDS.field;
+  field.setAttribute('aria-label', 'Your name');
+  field.autocomplete = 'off';
+  field.setAttribute('autocapitalize', 'words');
+  field.setAttribute('enterkeyhint', 'go');
+
+  const actions = node('div', 'js-actions');
+  const look = node('button', 'btn-ghost', SHELF_WORDS.look);
+  const go = node('button', 'btn-tonal js-go', SHELF_WORDS.join);
+  actions.append(go, look); // the answer first (left), Look around second — the welcome card's order
+
+  sheet.append(grab, head, namesWrap, field, actions);
+  document.body.append(back, sheet);
+
+  // ---- state: nobody, a name tapped, a name typed ----------------------------
+  let chosen = null; // a crew name, tapped or typed
+  const paint = () => {
+    const typed = field.value.trim();
+    const match = typed ? people.find((p) => p.name.toLowerCase() === typed.toLowerCase()) : null;
+    const who = chosen || (match && match.name) || null;
+    for (const c of chips) {
+      c.classList.toggle('on', c.dataset.name === who);
+      c.classList.toggle('off', !!who && c.dataset.name !== who);
+      c.setAttribute('aria-pressed', c.dataset.name === who ? 'true' : 'false');
+    }
+    if (who) { go.textContent = SHELF_WORDS.claim(who); go.disabled = false; }
+    else if (typed) { go.textContent = SHELF_WORDS.joinAs(typed); go.disabled = false; }
+    else { go.textContent = SHELF_WORDS.join; go.disabled = true; }
+  };
+  chips.forEach((c) => c.addEventListener('click', () => {
+    chosen = chosen === c.dataset.name ? null : c.dataset.name;
+    if (chosen) field.value = '';
+    paint();
+  }));
+  field.addEventListener('input', () => { chosen = null; paint(); });
+  // The keyboard: the names give way to the field — one sideways line instead
+  // of rows, so the field and both answers stay above the keys at 320.
+  field.addEventListener('focus', () => sheet.classList.add('typing'));
+  field.addEventListener('blur', () => sheet.classList.remove('typing'));
+  paint();
+  // More names than three rows hold: a soft fade says the list goes on.
+  const edge = () => namesWrap.classList.toggle('more', !sheet.classList.contains('typing')
+    && names.scrollHeight - names.clientHeight - names.scrollTop > 2);
+  names.addEventListener('scroll', edge, { passive: true });
+  field.addEventListener('focus', edge);
+  field.addEventListener('blur', edge);
+  requestAnimationFrame(edge);
+  setTimeout(edge, GROW_MS + CASCADE_MS + STAGGER_MS * (people.length + 3)); // after the names have landed (their arrival rides a 6px rise)
+
+  const leave = () => { closeJoinShelf({ ctx }); if (onLook) onLook(); };
+  look.addEventListener('click', leave);
+  back.addEventListener('click', leave);
+  go.addEventListener('click', () => {
+    const typed = field.value.trim();
+    const match = typed ? people.find((p) => p.name.toLowerCase() === typed.toLowerCase()) : null;
+    const who = chosen || (match && match.name);
+    if (who) { if (onClaim) onClaim(who); } else if (typed && onJoin) onJoin(typed);
+  });
+
+  // The way in: the wall dims, the shelf rises from the bottom edge on the
+  // arrival curve, then its lines land a beat apart and the names arrive one
+  // after another. Reduce Motion / Low Power: already there.
+  if (canAnimate(sheet, ctx)) {
+    back.animate([{ opacity: 0 }, { opacity: 1 }], { duration: GROW_MS, easing: 'ease-out', fill: 'backwards' });
+    sheet.animate([{ transform: 'translateY(100%)' }, { transform: 'none' }], { duration: GROW_MS, easing: EASE_ARRIVE, fill: 'backwards' });
+    const seq = [head, ...chips, field, actions];
+    seq.forEach((n, i) => n.animate(
+      [{ opacity: 0, transform: 'translateY(6px)' }, { opacity: 1, transform: 'none' }],
+      { duration: CASCADE_MS, delay: GROW_MS / 2 + i * STAGGER_MS, easing: EASE_ARRIVE, fill: 'backwards' },
+    ));
+  }
+  return sheet;
+}
+
+// The way out is quick and plain: the shelf drops, the backdrop lifts, the
+// wall underneath never moved.
+export function closeJoinShelf({ instant = false, ctx = null } = {}) {
+  const sheet = joinShelf();
+  if (!sheet) return;
+  sheet.removeAttribute('id');
+  const back = sheet.previousElementSibling && sheet.previousElementSibling.classList.contains('join-backdrop') ? sheet.previousElementSibling : null;
+  const gone = () => { sheet.remove(); if (back) back.remove(); };
+  if (instant || !canAnimate(sheet, ctx)) { gone(); return; }
+  sheet.style.pointerEvents = 'none';
+  if (back) back.animate([{ opacity: 1 }, { opacity: 0 }], { duration: OUT_MS, easing: EASE_LEAVE, fill: 'forwards' });
+  const out = sheet.animate([{ transform: 'none' }, { transform: 'translateY(100%)' }], { duration: OUT_MS, easing: EASE_LEAVE, fill: 'forwards' });
+  out.onfinish = gone;
+}
