{
  "name": "festival-navigator",
  "private": true,
  "description": "Offline-first festival planner with live crew sync — pick your set times together, works in a field with one bar of signal",
  "scripts": {
    "build": "echo 'No build step needed for static site'",
    "brand": "node scripts/brand-assets.mjs",
    "test": "node --import ./tests/helpers/night-clock.mjs --test tests/*.test.mjs",
    "test:browser": "BROWSER_TEST_REQUIRED=1 node --test tests/browser/*.test.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0"
  },
  "keywords": [
    "festival",
    "lineup",
    "schedule",
    "collaboration",
    "offline-first",
    "pwa"
  ],
  "author": "Kevin HG",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@resvg/resvg-js": "^2.6.2",
    "jpeg-js": "^0.4.4",
    "jsdom": "^30.1.3",
    "jsqr": "1.4.0",
    "playwright": "^1.64.1",
    "wawoff2": "^2.0.1"
  }
}
